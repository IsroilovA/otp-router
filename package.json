{
  "name": "otp-router-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "build": "pnpm --filter @otp-router/engine build && pnpm --filter @otp-router/server build && pnpm --filter @otp-router/client build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint --tsconfig tsconfig.json .",
    "typecheck": "pnpm build && tsc --project tsconfig.json && pnpm run lint:effect",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning",
    "test": "pnpm build && pnpm --filter otp-router-custom-adapter-example build && pnpm --filter otp-router-custom-adapter-example test && vitest run",
    "db:up": "docker compose -f apps/server/compose.yaml up -d --wait postgres",
    "db:down": "docker compose -f apps/server/compose.yaml down",
    "start": "pnpm --filter @otp-router/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/platform-node": "4.0.0-rc.116",
    "@effect/sql-pg": "4.0.0-rc.116",
    "@effect/tsgo": "0.47.1",
    "@effect/vitest": "4.0.0-rc.116",
    "@otp-router/client": "workspace:*",
    "@otp-router/engine": "workspace:*",
    "@otp-router/server": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/semver": "7.8.0",
    "effect": "4.0.0-rc.116",
    "eslint-plugin-sonarjs": "4.2.2",
    "libphonenumber-js": "1.13.14",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "pg-boss": "12.35.1",
    "semver": "7.8.5",
    "standardwebhooks": "1.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
