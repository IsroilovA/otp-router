{
  "name": "otp-router",
  "version": "0.0.0",
  "description": "A self-hosted service for routing phone-number OTP delivery.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity error .",
    "typecheck": "tsc --project tsconfig.json && pnpm run lint:effect",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "0.30.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.2",
    "@effect/platform-node": "0.108.2",
    "@effect/sql": "0.52.1",
    "@effect/sql-pg": "0.53.0",
    "effect": "3.22.2",
    "pg-boss": "12.33.2"
  }
}
