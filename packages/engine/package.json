{
  "name": "@otp-router/engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116",
    "libphonenumber-js": "1.13.14",
    "pg-boss": "12.35.1",
    "standardwebhooks": "1.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/config.d.ts",
      "import": "./dist/config/config.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./challenges": {
      "types": "./dist/challenges/index.d.ts",
      "import": "./dist/challenges/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "import": "./dist/delivery/index.js"
    },
    "./history": {
      "types": "./dist/history/contracts.d.ts",
      "import": "./dist/history/contracts.js"
    },
    "./projects": {
      "types": "./dist/projects/index.d.ts",
      "import": "./dist/projects/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/contracts.d.ts",
      "import": "./dist/runtime/contracts.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
