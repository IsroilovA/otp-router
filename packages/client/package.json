{
  "name": "@otp-router/client",
  "version": "0.3.0",
  "description": "Typed backend HTTP client for self-hosted OTP Router",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "pack:check": "node scripts/check-pack.ts"
  },
  "dependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@otp-router/server": "workspace:*",
    "rolldown": "1.2.15",
    "rolldown-plugin-dts": "0.28.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsroilovA/otp-router.git",
    "directory": "packages/client"
  }
}
