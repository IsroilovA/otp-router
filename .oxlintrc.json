{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "vitest", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "coverage/**", "node_modules/**"],
  "rules": {
    "complexity": [
      "error",
      {
        "max": 15,
        "variant": "modified"
      }
    ],
    "max-depth": ["error", 4],
    "max-params": ["error", 4],
    "eqeqeq": ["error", "always"],
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": false
      }
    ],
    "typescript/only-throw-error": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "minimumDescriptionLength": 10,
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false
      }
    ],
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/valid-expect": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": [
          "it.effect",
          "it.scoped",
          "it.live",
          "it.scopedLive",
          "effect",
          "scoped",
          "live",
          "scopedLive"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/engine/src/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "env",
            "message": "The application loads environment values and supplies engine settings."
          },
          {
            "object": "process",
            "property": "argv",
            "message": "The application owns command-line arguments."
          }
        ]
      }
    },
    {
      "files": [
        "packages/engine/src/challenges/**/*.ts",
        "packages/engine/src/delivery/**/*.ts",
        "packages/engine/src/notifications/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/http", "**/http/**", "**/worker", "**/worker/**"],
                "message": "Features must not depend on HTTP or worker entry points."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/engine/src/providers/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/challenges",
                  "**/challenges/**",
                  "**/delivery",
                  "**/delivery/**",
                  "**/http",
                  "**/http/**",
                  "**/worker",
                  "**/worker/**",
                  "**/notifications",
                  "**/notifications/**"
                ],
                "message": "Provider adapters translate external outcomes; feature orchestration stays outside providers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/**/*.ts", "examples/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/packages/engine/**",
                  "**/engine/src/**",
                  "@otp-router/engine/src/**",
                  "@otp-router/engine/dist/**"
                ],
                "message": "Consumers must use supported engine package exports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/engine/src/delivery/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/challenges",
                  "**/challenges/**",
                  "**/http",
                  "**/http/**",
                  "**/worker",
                  "**/worker/**"
                ],
                "message": "Delivery is independent of managed verification, HTTP and worker entry points."
              }
            ]
          }
        ]
      }
    }
  ]
}
